---
const oilProducts = [
  {
    id: 1,
    name: "Brent Crude Oil",
    region: "North Sea",
    price: "$82 / Barrel",
    minOrder: "1,000 Barrels",
    image: "/images/brent-oil.jpg",
    payment: "USDC • BTC • ETH",
  },

  {
    id: 2,
    name: "WTI Crude Oil",
    region: "United States",
    price: "$79 / Barrel",
    minOrder: "5,000 Barrels",
    image: "/images/wti-oil.jpg",
    payment: "USDC • BTC • ETH",
  },

  {
    id: 3,
    name: "Jet Fuel A-1",
    region: "Middle East",
    price: "$2.85 / Gallon",
    minOrder: "50,000 Gallons",
    image: "/images/jet-fuel.jpg",
    payment: "USDC • BTC • ETH",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>AmicBridge | Oil Trading With Crypto</title>

    <style>

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        background: #0a0a0a;
        color: white;
      }

      a {
        text-decoration: none;
      }

      .navbar {
        width: 100%;
        padding: 28px 60px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: fixed;
        top: 0;
        z-index: 999;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }

      .logo {
        font-size: 38px;
        font-weight: 900;
        letter-spacing: 1px;
      }

      .logo span {
        color: #d6a85f;
      }

      .nav-links {
        display: flex;
        gap: 35px;
      }

      .nav-links a {
        color: white;
        font-size: 16px;
        font-weight: bold;
        transition: 0.3s;
      }

      .nav-links a:hover {
        color: #d6a85f;
      }

      .hero {
        height: 100vh;
        background:
          linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.85)),
          url('/images/oil-bg.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
      }

      .hero-content {
        max-width: 1000px;
      }

      .hero h1 {
        font-size: 88px;
        font-weight: 900;
        line-height: 1.1;
        margin-bottom: 24px;
      }

      .hero span {
        color: #d6a85f;
      }

      .hero p {
        font-size: 24px;
        color: #cccccc;
        line-height: 1.7;
        margin-bottom: 40px;
      }

      .hero-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
      }

      .btn {
        padding: 18px 34px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        transition: 0.3s;
      }

      .primary-btn {
        background: #d6a85f;
        color: black;
      }

      .secondary-btn {
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
      }

      .btn:hover {
        transform: translateY(-3px);
      }

      .section {
        padding: 120px 30px;
      }

      .section-title {
        text-align: center;
        font-size: 64px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .section-subtitle {
        text-align: center;
        color: #999;
        font-size: 22px;
        margin-bottom: 70px;
      }

      .products {
        max-width: 1450px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 30px;
      }

      .card {
        background: #121212;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        transition: 0.3s;
      }

      .card:hover {
        transform: translateY(-6px);
      }

      .card img {
        width: 100%;
        height: 280px;
        object-fit: cover;
      }

      .card-content {
        padding: 32px;
      }

      .card h3 {
        font-size: 34px;
        margin-bottom: 12px;
      }

      .region {
        color: #d6a85f;
        margin-bottom: 18px;
        font-weight: bold;
      }

      .price {
        font-size: 46px;
        font-weight: 900;
        margin-bottom: 20px;
      }

      .info {
        color: #aaa;
        line-height: 1.8;
        margin-bottom: 26px;
      }

      .buy-btn {
        width: 100%;
        background: #d6a85f;
        color: black;
        border: none;
        padding: 18px;
        border-radius: 999px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
      }

      .trust-grid {
        max-width: 1450px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
      }

      .trust-card {
        background: #121212;
        padding: 40px;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,0.05);
      }

      .trust-card h3 {
        font-size: 28px;
        margin-bottom: 18px;
      }

      .trust-card p {
        color: #999;
        line-height: 1.8;
        font-size: 17px;
      }

      .stats {
        max-width: 1300px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
      }

      .stat-box {
        text-align: center;
        background: #121212;
        padding: 50px 20px;
        border-radius: 28px;
      }

      .stat-box h2 {
        font-size: 64px;
        color: #d6a85f;
        margin-bottom: 12px;
      }

      .stat-box p {
        color: #999;
        font-size: 18px;
      }

      .contact {
        max-width: 1000px;
        margin: auto;
        background: #121212;
        padding: 60px;
        border-radius: 28px;
        text-align: center;
      }

      .contact h2 {
        font-size: 52px;
        margin-bottom: 20px;
      }

      .contact p {
        color: #999;
        font-size: 20px;
        margin-bottom: 14px;
      }

      .email {
        color: #d6a85f;
        font-size: 28px;
        font-weight: bold;
      }

      footer {
        padding: 60px 20px;
        text-align: center;
        border-top: 1px solid rgba(255,255,255,0.06);
        color: #777;
      }

      @media(max-width: 768px){

        .hero h1{
          font-size: 54px;
        }

        .section-title{
          font-size: 42px;
        }

        .navbar{
          padding: 22px;
        }

        .nav-links{
          display:none;
        }

      }

    </style>
  </head>

  <body>

    <nav class="navbar">

      <div class="logo">
        Amic<span>Bridge</span>
      </div>

      <div class="nav-links">
        <a href="#products">Oil</a>
        <a href="#trust">Trust</a>
        <a href="#stats">Markets</a>
        <a href="#contact">Contact</a>
      </div>

    </nav>

    <section class="hero">

      <div class="hero-content">

        <h1>
          Global Oil Trading <br />
          Powered By <span>Crypto</span>
        </h1>

        <p>
          Buy and settle oil transactions using USDC, Bitcoin and Ethereum.
          Fast international settlement for energy buyers worldwide.
        </p>

        <div class="hero-buttons">

          <a href="#products" class="btn primary-btn">
            Explore Oil Markets
          </a>

          <a href="#trust" class="btn secondary-btn">
            Why AmicBridge
          </a>

        </div>

      </div>

    </section>

    <section class="section" id="products">

      <h2 class="section-title">
        Energy Products
      </h2>

      <p class="section-subtitle">
        International energy products available with crypto settlement.
      </p>

      <div class="products">

        {
          oilProducts.map((oil) => (

            <div class="card">

              <img src={oil.image} alt={oil.name} />

              <div class="card-content">

                <h3>{oil.name}</h3>

                <div class="region">
                  {oil.region}
                </div>

                <div class="price">
                  {oil.price}
                </div>

                <div class="info">
                  Minimum Order: {oil.minOrder}
                  <br /><br />
                  Payment Methods: {oil.payment}
                </div>

                <button class="buy-btn">
                  Request Trade
                </button>

              </div>

            </div>

          ))
        }

      </div>

    </section>

    <section class="section" id="trust">

      <h2 class="section-title">
        Built Around Trust
      </h2>

      <p class="section-subtitle">
        Transparent energy trade infrastructure for the crypto era.
      </p>

      <div class="trust-grid">

        <div class="trust-card">

          <h3>Escrow Settlement</h3>

          <p>
            Funds can be secured through trusted escrow systems before shipment release.
          </p>

        </div>

        <div class="trust-card">

          <h3>Global Crypto Payments</h3>

          <p>
            International buyers can settle trades instantly using stablecoins.
          </p>

        </div>

        <div class="trust-card">

          <h3>Verified Documentation</h3>

          <p>
            Shipment documentation and verification processes help create trust between buyers and suppliers.
          </p>

        </div>

      </div>

    </section>

    <section class="section" id="stats">

      <h2 class="section-title">
        Market Access
      </h2>

      <p class="section-subtitle">
        Connecting crypto capital with global energy markets.
      </p>

      <div class="stats">

        <div class="stat-box">
          <h2>24/7</h2>
          <p>Crypto Settlement</p>
        </div>

        <div class="stat-box">
          <h2>190+</h2>
          <p>Countries Supported</p>
        </div>

        <div class="stat-box">
          <h2>USDC</h2>
          <p>Main Settlement Asset</p>
        </div>

        <div class="stat-box">
          <h2>Fast</h2>
          <p>International Transfers</p>
        </div>

      </div>

    </section>

    <section class="section" id="contact">

      <div class="contact">

        <h2>Contact Trading Desk</h2>

        <p>
          For wholesale oil orders and institutional partnerships.
        </p>

        <div class="email">
          trade@amicbridge.com phone 92928373
        </div>

      </div>

    </section>

    <footer>

      © 2026 AmicBridge. Global energy trading platform powered by crypto settlement.

    </footer>

  </body>
</html>
