---
import BaseLayout from "../layouts/BaseLayout.astro";
import DealCard from "../components/DealCard.astro";
import { starterDeals } from "../data/deals";

const featuredDeals = starterDeals.slice(0, 3);
---

<BaseLayout
  title="AmicBridge | Trust-first funding pools"
  description="AmicBridge lets people pool money to fund real opportunities through clear, structured agreements."
>
  <section class="container hero">
    <div>
      <div class="eyebrow">Trust before money</div>
      <h1>Pool money. Fund opportunities. Earn together.</h1>
      <p class="lead">
        AmicBridge is a trust-first funding platform where borrowers create deals,
        customers join funding pools, and every opportunity is presented with clarity,
        structure, and transparent progress.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/deals">Browse deals</a>
        <a class="btn btn-secondary" href="/create-deal">Create deal</a>
      </div>
    </div>

    <div class="card">
      <div class="section-copy" style="margin-bottom: 18px;">
        Modern private funding should feel simple, transparent, and structured.
      </div>
      <div class="steps">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Create or discover</h3>
          <p class="muted">Borrowers post funding requests. Customers browse live opportunities.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Join the pool</h3>
          <p class="muted">Multiple people contribute smaller amounts into one structured deal.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Track progress</h3>
          <p class="muted">See funding levels, terms, and expected return in one clear place.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container card-grid">
      <div class="stat-card">
        <div class="stat-label">Model</div>
        <div class="stat-value">Deal pools</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Structure</div>
        <div class="stat-value">Transparent</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Launch path</div>
        <div class="stat-value">Fast MVP</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>How AmicBridge works</h2>
          <p class="section-copy">
            The first version focuses on a clean deal-based model. One borrower, one deal,
            one pool, many contributors.
          </p>
        </div>
      </div>

      <div class="steps">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Borrower creates a deal</h3>
          <p class="muted">
            A funding request is posted with amount, duration, category, and return.
          </p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Pool opens automatically</h3>
          <p class="muted">
            Customers can contribute smaller amounts until the target is reached.
          </p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Track funding in real time</h3>
          <p class="muted">
            The marketplace updates progress and closes a pool once funded.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Featured deals</h2>
          <p class="section-copy">
            Start with visible, understandable opportunities. Trust grows when the deal is easy to understand.
          </p>
        </div>
        <a class="btn btn-secondary" href="/deals">See all deals</a>
      </div>

      <div class="deal-grid">
        {featuredDeals.map((deal) => <DealCard deal={deal} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div class="card">
        <h2>Why this page works right now</h2>
        <p class="muted">
          This version positions AmicBridge as a trust-first funding marketplace instead of
          an overbuilt finance platform. It is clear, modern, and easy to deploy on Netlify.
        </p>
        <div class="pill-row" style="margin-top:16px;">
          <div class="pill">Trust-first</div>
          <div class="pill">Simple structure</div>
          <div class="pill">Deal-based pools</div>
          <div class="pill">Fast launch</div>
        </div>
      </div>

      <div class="card">
        <h2>Best next move</h2>
        <p class="muted">
          Launch this MVP with mock data, prove interest, then connect Supabase for real deal storage.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/deals">Open marketplace</a>
          <a class="btn btn-secondary" href="/create-deal">Post a deal</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
