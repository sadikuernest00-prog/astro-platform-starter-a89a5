---
const markets = [
  {
    symbol: "BRENT",
    price: "$82.31",
    change: "+2.1%",
  },

  {
    symbol: "WTI",
    price: "$79.44",
    change: "+1.7%",
  },

  {
    symbol: "BTC",
    price: "$108,220",
    change: "+4.8%",
  },

  {
    symbol: "USDC",
    price: "$1.00",
    change: "Stable",
  },
];

const services = [
  {
    title: "Crypto Escrow",
    text: "Funds remain protected until both parties verify shipment and documentation.",
  },

  {
    title: "OTC Trading Desk",
    text: "Private institutional commodity transactions with stablecoin settlement.",
  },

  {
    title: "Global Settlement",
    text: "International energy transactions settled using USDC and blockchain infrastructure.",
  },

  {
    title: "Verified Suppliers",
    text: "Supplier verification and trade documentation for higher transaction trust.",
  },
];

const process = [
  "Buyer requests quote",
  "Supplier confirms deal",
  "USDC escrow funded",
  "Shipment released",
  "Documents verified",
  "Payment settled",
];
---

<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      AmicBridge | Global Commodity Settlement
    </title>

    <style>

      *{
        margin:0;
        padding:0;
        box-sizing:border-box;
      }

      html{
        scroll-behavior:smooth;
      }

      body{
        font-family:Arial, sans-serif;
        background:#050505;
        color:white;
      }

      a{
        text-decoration:none;
      }

      .ticker{
        width:100%;
        background:#0d0d0d;
        border-bottom:1px solid rgba(255,255,255,0.08);
        overflow:hidden;
        white-space:nowrap;
      }

      .ticker-track{
        display:flex;
        gap:60px;
        padding:14px 0;
        animation:ticker 20s linear infinite;
      }

      .ticker-item{
        font-size:15px;
        color:#d6d6d6;
      }

      .green{
        color:#3ddc84;
        font-weight:bold;
      }

      @keyframes ticker{
        0%{
          transform:translateX(0);
        }

        100%{
          transform:translateX(-50%);
        }
      }

      .navbar{
        width:100%;
        padding:28px 60px;
        display:flex;
        justify-content:space-between;
        align-items:center;
        position:sticky;
        top:0;
        z-index:999;
        background:rgba(5,5,5,0.9);
        backdrop-filter:blur(12px);
        border-bottom:1px solid rgba(255,255,255,0.06);
      }

      .logo{
        font-size:40px;
        font-weight:900;
        letter-spacing:1px;
      }

      .logo span{
        color:#d6a85f;
      }

      .nav-links{
        display:flex;
        gap:34px;
      }

      .nav-links a{
        color:white;
        font-size:15px;
        font-weight:bold;
        transition:0.3s;
      }

      .nav-links a:hover{
        color:#d6a85f;
      }

      .hero{
        min-height:100vh;
        display:flex;
        align-items:center;
        justify-content:center;
        text-align:center;
        padding:100px 20px;
        background:
          linear-gradient(
            rgba(0,0,0,0.82),
            rgba(0,0,0,0.92)
          ),
          url('/images/oil-bg.jpg');

        background-size:cover;
        background-position:center;
      }

      .hero-content{
        max-width:1100px;
      }

      .hero-tag{
        display:inline-block;
        padding:12px 20px;
        border-radius:999px;
        background:rgba(214,168,95,0.12);
        border:1px solid rgba(214,168,95,0.25);
        color:#d6a85f;
        font-size:14px;
        font-weight:bold;
        margin-bottom:28px;
      }

      .hero h1{
        font-size:92px;
        line-height:1.05;
        margin-bottom:30px;
        font-weight:900;
      }

      .hero span{
        color:#d6a85f;
      }

      .hero p{
        color:#b9b9b9;
        font-size:24px;
        line-height:1.7;
        margin-bottom:40px;
      }

      .hero-buttons{
        display:flex;
        justify-content:center;
        gap:20px;
        flex-wrap:wrap;
      }

      .btn{
        padding:18px 34px;
        border-radius:999px;
        font-size:17px;
        font-weight:bold;
        transition:0.3s;
      }

      .primary-btn{
        background:#d6a85f;
        color:black;
      }

      .secondary-btn{
        border:1px solid rgba(255,255,255,0.1);
        color:white;
      }

      .btn:hover{
        transform:translateY(-4px);
      }

      .section{
        padding:120px 30px;
      }

      .section-title{
        text-align:center;
        font-size:64px;
        margin-bottom:18px;
        font-weight:900;
      }

      .section-subtitle{
        text-align:center;
        color:#999;
        max-width:900px;
        margin:0 auto 70px;
        line-height:1.7;
        font-size:22px;
      }

      .services-grid{
        max-width:1450px;
        margin:auto;
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
        gap:28px;
      }

      .service-card{
        background:#0f0f0f;
        border:1px solid rgba(255,255,255,0.05);
        border-radius:28px;
        padding:40px;
        transition:0.3s;
      }

      .service-card:hover{
        transform:translateY(-6px);
      }

      .service-card h3{
        font-size:30px;
        margin-bottom:20px;
      }

      .service-card p{
        color:#9d9d9d;
        line-height:1.8;
        font-size:17px;
      }

      .stats{
        max-width:1350px;
        margin:auto;
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
        gap:28px;
      }

      .stat-box{
        background:#0f0f0f;
        border-radius:28px;
        padding:50px 20px;
        text-align:center;
      }

      .stat-box h2{
        font-size:68px;
        color:#d6a85f;
        margin-bottom:12px;
      }

      .stat-box p{
        color:#999;
        font-size:18px;
      }

      .process-grid{
        max-width:1200px;
        margin:auto;
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
        gap:24px;
      }

      .process-card{
        background:#0f0f0f;
        padding:36px;
        border-radius:24px;
        position:relative;
      }

      .step{
        width:52px;
        height:52px;
        background:#d6a85f;
        color:black;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        font-weight:bold;
        font-size:20px;
        margin-bottom:24px;
      }

      .process-card h3{
        font-size:28px;
        line-height:1.4;
      }

      .quote-box{
        max-width:1000px;
        margin:auto;
        background:#0f0f0f;
        border-radius:32px;
        padding:60px;
      }

      .quote-box h2{
        font-size:52px;
        margin-bottom:20px;
        text-align:center;
      }

      .quote-box p{
        text-align:center;
        color:#999;
        margin-bottom:40px;
        font-size:20px;
      }

      .quote-form{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:20px;
      }

      .quote-form input,
      .quote-form textarea{
        width:100%;
        padding:18px;
        border-radius:16px;
        border:none;
        background:#1a1a1a;
        color:white;
        font-size:16px;
      }

      .quote-form textarea{
        min-height:140px;
        resize:none;
        grid-column:span 2;
      }

      .quote-form button{
        grid-column:span 2;
        border:none;
        padding:20px;
        border-radius:999px;
        background:#d6a85f;
        color:black;
        font-size:18px;
        font-weight:bold;
        cursor:pointer;
      }

      footer{
        padding:70px 20px;
        text-align:center;
        border-top:1px solid rgba(255,255,255,0.05);
      }

      footer h3{
        font-size:42px;
        margin-bottom:14px;
      }

      footer p{
        color:#888;
        line-height:1.7;
      }

      @media(max-width:900px){

        .hero h1{
          font-size:58px;
        }

        .section-title{
          font-size:42px;
        }

        .navbar{
          padding:24px;
        }

        .nav-links{
          display:none;
        }

        .quote-form{
          grid-template-columns:1fr;
        }

        .quote-form textarea,
        .quote-form button{
          grid-column:span 1;
        }

      }

    </style>

  </head>

  <body>

    <div class="ticker">

      <div class="ticker-track">

        {
          [...markets, ...markets].map((market) => (

            <div class="ticker-item">

              {market.symbol} — {market.price}

              <span class="green">
                {market.change}
              </span>

            </div>

          ))
        }

      </div>

    </div>

    <nav class="navbar">

      <div class="logo">
        Amic<span>Bridge</span>
      </div>

      <div class="nav-links">

        <a href="#services">
          Services
        </a>

        <a href="#process">
          Process
        </a>

        <a href="#quote">
          Request Quote
        </a>

      </div>

    </nav>

    <section class="hero">

      <div class="hero-content">

        <div class="hero-tag">
          GLOBAL CRYPTO COMMODITY INFRASTRUCTURE
        </div>

        <h1>

          Secure Escrow Infrastructure
          For International
          <span>Energy Trade</span>

        </h1>

        <p>

          AmicBridge provides OTC commodity settlement
          infrastructure powered by stablecoins, escrow
          protection and blockchain-based international payments.

        </p>

        <div class="hero-buttons">

          <a href="#quote" class="btn primary-btn">
            Request Institutional Access
          </a>

          <a href="#services" class="btn secondary-btn">
            Explore Platform
          </a>

        </div>

      </div>

    </section>

    <section class="section" id="services">

      <h2 class="section-title">
        Institutional Services
      </h2>

      <p class="section-subtitle">

        Infrastructure designed for international
        commodity buyers, suppliers and brokers.

      </p>

      <div class="services-grid">

        {
          services.map((service) => (

            <div class="service-card">

              <h3>
                {service.title}
              </h3>

              <p>
                {service.text}
              </p>

            </div>

          ))
        }

      </div>

    </section>

    <section class="section">

      <h2 class="section-title">
        Market Access
      </h2>

      <p class="section-subtitle">

        Stablecoin infrastructure enabling
        faster international commodity settlement.

      </p>

      <div class="stats">

        <div class="stat-box">
          <h2>24/7</h2>
          <p>Settlement Availability</p>
        </div>

        <div class="stat-box">
          <h2>190+</h2>
          <p>Countries Supported</p>
        </div>

        <div class="stat-box">
          <h2>USDC</h2>
          <p>Main Settlement Asset</p>
        </div>

        <div class="stat-box">
          <h2>OTC</h2>
          <p>Institutional Trade Desk</p>
        </div>

      </div>

    </section>

    <section class="section" id="process">

      <h2 class="section-title">
        Escrow Settlement Process
      </h2>

      <p class="section-subtitle">

        Structured trade workflow for
        secure international transactions.

      </p>

      <div class="process-grid">

        {
          process.map((step, index) => (

            <div class="process-card">

              <div class="step">
                {index + 1}
              </div>

              <h3>
                {step}
              </h3>

            </div>

          ))
        }

      </div>

    </section>

    <section class="section" id="quote">

      <div class="quote-box">

        <h2>
          Request Institutional Access
        </h2>

        <p>

          Speak with the AmicBridge trading desk
          regarding commodity settlement and escrow services.

        </p>

        <form class="quote-form">

          <input
            type="text"
            placeholder="Company Name"
          />

          <input
            type="email"
            placeholder="Business Email"
          />

          <input
            type="text"
            placeholder="Country"
          />

          <input
            type="text"
            placeholder="Commodity Interest"
          />

          <textarea
            placeholder="Transaction details..."
          ></textarea>

          <button>
            Submit Request
          </button>

        </form>

      </div>

    </section>

    <footer>

      <h3>
        AmicBridge
      </h3>

      <p>

        Global crypto settlement infrastructure
        for international commodity markets.

        <br /><br />

        trade@amicbridge.com

      </p>

    </footer>

  </body>

</html>
