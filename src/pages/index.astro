---
import { Image } from 'astro:assets';
import LuxuryLayout from '../layouts/LuxuryLayout.astro';
import WhatsAppIcon from '../components/lux/WhatsAppIcon.astro';
import { diamonds, formatPrice, formatCarat, categoryLabels } from '../data/diamonds';
import { site, whatsappLink, defaultWhatsappMessage } from '../data/site';
import hero from '../assets/diamonds/hero.png';
import about from '../assets/diamonds/about.png';

const listings = diamonds.filter((d) => d.category !== 'jewelry').slice(0, 6);
const inquiry = (d: (typeof diamonds)[number]) =>
    `Hello ${site.name}, I am interested in: ${d.name} (Ref ${d.sku}) — ${formatCarat(d.carat, d.category)}, ${d.shape}, Color ${d.color}, Clarity ${d.clarity}, Price: ${formatPrice(d.price)}. Is it available?`;
---
<LuxuryLayout>
    <section id="home" class="hero">
        <Image src={hero} alt="Brilliant round diamond on black background" class="hero-bg" widths={[800, 1376]} sizes="100vw" loading="eager" />
        <div class="container">
            <div class="hero-content">
                <p class="eyebrow">{site.tagline}</p>
                <h1>LUXURY <span>DIAMONDS</span></h1>
                <p>Certified natural and lab-grown diamonds, selected for brilliance and offered with transparent pricing. Browse the collection and inquire directly on WhatsApp.</p>
                <div class="btn-row">
                    <a href="#catalogue" class="btn btn-gold">Browse Diamonds</a>
                    <a href={whatsappLink(defaultWhatsappMessage)} target="_blank" rel="noopener noreferrer" class="btn btn-outline"><WhatsAppIcon size={18} /> WhatsApp Us</a>
                </div>
            </div>
        </div>
    </section>

    <section id="catalogue" class="section">
        <div class="container">
            <div class="section-head">
                <p class="eyebrow">The Collection</p>
                <h2>Diamond Catalogue</h2>
                <p>Sample listings shown — every stone comes with its grading certificate.</p>
            </div>
            <div class="grid">
                {listings.map((d) => (
                    <article class="card">
                        <div class="card-img">
                            <Image src={d.image} alt={`${d.name}, ${d.shape} diamond`} widths={[400, 700]} sizes="(max-width:520px) 100vw, 380px" />
                            <span class="badge">{d.sample ? 'Sample' : categoryLabels[d.category]}</span>
                        </div>
                        <div class="card-body">
                            <h3>{d.name}</h3>
                            <dl class="specs">
                                <div><dt>Carat</dt><dd>{formatCarat(d.carat, d.category)}</dd></div>
                                <div><dt>Shape</dt><dd>{d.shape}</dd></div>
                                <div><dt>Color</dt><dd>{d.color}</dd></div>
                                <div><dt>Clarity</dt><dd>{d.clarity}</dd></div>
                            </dl>
                            <p class="price">{formatPrice(d.price)}</p>
                            <a href={whatsappLink(inquiry(d))} target="_blank" rel="noopener noreferrer" class="btn btn-gold"><WhatsAppIcon size={18} /> Inquire on WhatsApp</a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="about" class="section">
        <div class="container about">
            <Image src={about} alt="Loose diamonds with loupe and tweezers" widths={[600, 1000]} sizes="(max-width:860px) 100vw, 560px" />
            <div>
                <p class="eyebrow">About Us</p>
                <h2>Quality, Transparency &amp; Service</h2>
                <p>{site.name} sources exceptional diamonds for private collectors and businesses worldwide. Every stone is independently certified by GIA or IGI.</p>
                <p>We believe in clear pricing, honest grading and personal service — speak directly with us for advice, videos or a private viewing.</p>
            </div>
        </div>
    </section>

    <section id="contact" class="section">
        <div class="container">
            <div class="contact-box">
                <p class="eyebrow">Contact</p>
                <h2>Find Your Perfect Diamond</h2>
                <p>Message us on WhatsApp at {site.whatsappDisplay} for availability, pricing and shipping.</p>
                <div class="btn-row">
                    <a href={whatsappLink(defaultWhatsappMessage)} target="_blank" rel="noopener noreferrer" class="btn btn-gold"><WhatsAppIcon size={18} /> Chat on WhatsApp</a>
                </div>
            </div>
        </div>
    </section>
</LuxuryLayout>
