---
import { categories, products, whatsappLink, WHATSAPP_URL, WHATSAPP_DISPLAY } from '../data/products';

const categoryName = (id: string) => categories.find((c) => c.id === id)?.name ?? '';

const sellLink = whatsappLink('Hello AmicBridge, I would like to list a product on your marketplace.');
const buyLink = whatsappLink('Hello AmicBridge, I am looking for a product. Can you help?');

const steps = [
    { title: 'Contact AmicBridge', text: 'Message us on WhatsApp about the product you want to buy or sell.' },
    { title: 'We introduce you', text: 'We verify the request and connect serious buyers with the right seller.' },
    { title: 'Negotiate directly', text: 'Buyer and seller agree price and terms directly with each other.' }
];

const waIcon = `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.45-9.44a9.4 9.4 0 0 1 6.68 2.77 9.38 9.38 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44m8.04-17.48A11.3 11.3 0 0 0 12.05.7C5.78.7.68 5.8.68 12.06c0 2 .52 3.96 1.52 5.68L.58 23.7l6.1-1.6a11.33 11.33 0 0 0 5.37 1.37h.01c6.26 0 11.36-5.1 11.37-11.37 0-3.03-1.18-5.89-3.34-8.04"/></svg>`;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>AmicBridge | Global B2B Marketplace for Diamonds, Cars & Commodities</title>
        <meta
            name="description"
            content="AmicBridge connects buyers and sellers worldwide for diamonds, cars, commodities and more. Contact us on WhatsApp — prices negotiated directly."
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <style is:global>
            :root {
                --navy: #0b1f3a;
                --navy-2: #13315c;
                --navy-soft: #e9eef6;
                --white: #ffffff;
                --text: #0f1b2d;
                --muted: #5b6b82;
                --line: #dbe3ee;
                --green: #1fa463;
                --green-dark: #168a52;
                --radius: 16px;
                --max: 1180px;
            }
            * { margin: 0; padding: 0; box-sizing: border-box; }
            html { scroll-behavior: smooth; }
            body {
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
                color: var(--text);
                background: var(--white);
                line-height: 1.6;
            }
            a { color: inherit; text-decoration: none; }
            img { display: block; max-width: 100%; }
            .container { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }

            /* Buttons */
            .btn {
                display: inline-flex; align-items: center; justify-content: center; gap: 8px;
                padding: 13px 22px; border-radius: 999px; font-weight: 700; font-size: 15px;
                transition: transform .2s, background .2s, box-shadow .2s; white-space: nowrap;
            }
            .btn:hover { transform: translateY(-2px); }
            .btn-wa { background: var(--green); color: #fff; box-shadow: 0 8px 20px rgba(31,164,99,.25); }
            .btn-wa:hover { background: var(--green-dark); }
            .btn-light { background: #fff; color: var(--navy); }
            .btn-outline { border: 1.5px solid rgba(255,255,255,.5); color: #fff; }
            .btn-outline:hover { background: rgba(255,255,255,.1); }
            .btn-navy { background: var(--navy); color: #fff; }
            .btn-block { width: 100%; }

            /* Header */
            .header { position: sticky; top: 0; z-index: 50; background: var(--navy); color: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.15); }
            .nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; }
            .logo { font-size: 24px; font-weight: 900; letter-spacing: .5px; }
            .logo span { color: #7fd8a8; }
            .nav-links { display: flex; gap: 26px; font-weight: 600; font-size: 15px; }
            .nav-links a { opacity: .85; }
            .nav-links a:hover { opacity: 1; }
            .nav .btn { padding: 10px 18px; font-size: 14px; }

            /* Hero */
            .hero {
                background:
                    linear-gradient(110deg, rgba(11,31,58,.96) 0%, rgba(11,31,58,.85) 50%, rgba(11,31,58,.55) 100%),
                    url('https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&w=1800&q=70') center/cover;
                color: #fff; padding: 110px 0 120px;
            }
            .eyebrow {
                display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
                color: #7fd8a8; margin-bottom: 18px;
            }
            .hero h1 { font-size: clamp(2.3rem, 5.5vw, 4.2rem); line-height: 1.08; font-weight: 800; max-width: 760px; margin-bottom: 22px; }
            .hero p { font-size: clamp(1.05rem, 2vw, 1.25rem); color: #c9d5e6; max-width: 620px; margin-bottom: 34px; }
            .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
            .hero-points { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 44px; color: #c9d5e6; font-size: 15px; }
            .hero-points li { list-style: none; }
            .hero-points li::before { content: '✓'; color: #7fd8a8; font-weight: 800; margin-right: 8px; }

            /* Sections */
            .section { padding: 90px 0; }
            .section-alt { background: var(--navy-soft); }
            .section-head { text-align: center; max-width: 680px; margin: 0 auto 48px; }
            .section-head .eyebrow { color: var(--green); }
            .section-head h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.15; color: var(--navy); margin-bottom: 12px; }
            .section-head p { color: var(--muted); font-size: 17px; }

            /* Categories */
            .cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
            .cat-card {
                position: relative; border-radius: var(--radius); overflow: hidden; min-height: 320px; color: #fff;
                display: flex; flex-direction: column; justify-content: flex-end; padding: 24px;
            }
            .cat-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
            .cat-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,31,58,.95) 15%, rgba(11,31,58,.2) 75%); }
            .cat-card:hover img { transform: scale(1.05); }
            .cat-card > div { position: relative; z-index: 1; }
            .cat-card h3 { font-size: 22px; margin-bottom: 6px; }
            .cat-card p { font-size: 14px; color: #d4deec; margin-bottom: 12px; }
            .cat-card ul { display: flex; flex-wrap: wrap; gap: 6px; }
            .cat-card li { list-style: none; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,.15); }

            /* Products */
            .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
            .prod-card {
                background: #fff; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
                display: flex; flex-direction: column; transition: box-shadow .25s, transform .25s;
            }
            .prod-card:hover { box-shadow: 0 18px 40px rgba(11,31,58,.12); transform: translateY(-4px); }
            .prod-img { position: relative; aspect-ratio: 4 / 3; background: var(--navy-soft); }
            .prod-img img { width: 100%; height: 100%; object-fit: cover; }
            .prod-tag {
                position: absolute; top: 12px; left: 12px; background: var(--navy); color: #fff;
                font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 999px;
            }
            .prod-body { padding: 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
            .prod-cat { font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--green); }
            .prod-body h3 { font-size: 20px; color: var(--navy); line-height: 1.2; }
            .prod-body p { color: var(--muted); font-size: 14px; }
            .prod-details li { list-style: none; font-size: 13px; color: var(--text); padding: 3px 0; }
            .prod-details li::before { content: '•'; color: var(--green); font-weight: 900; margin-right: 8px; }
            .prod-price { font-size: 13px; font-weight: 600; color: var(--navy-2); background: var(--navy-soft); border-radius: 8px; padding: 8px 12px; }
            .prod-body .btn { margin-top: auto; }
            .more-note { text-align: center; margin-top: 40px; color: var(--muted); }
            .more-note a { color: var(--green); font-weight: 700; }

            /* Steps */
            .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
            .step { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
            .step-num {
                width: 42px; height: 42px; border-radius: 50%; background: var(--navy); color: #fff;
                display: grid; place-items: center; font-weight: 800; margin-bottom: 16px;
            }
            .step h3 { color: var(--navy); font-size: 19px; margin-bottom: 8px; }
            .step p { color: var(--muted); font-size: 15px; }

            /* Sell */
            .sell { background: var(--navy); color: #fff; border-radius: 24px; padding: 56px; display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; }
            .sell .eyebrow { color: #7fd8a8; }
            .sell h2 { font-size: clamp(1.8rem, 3.5vw, 2.5rem); line-height: 1.15; margin-bottom: 14px; }
            .sell p { color: #c9d5e6; margin-bottom: 24px; }
            .sell ul { display: grid; gap: 12px; }
            .sell li { list-style: none; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 12px; padding: 14px 18px; }
            .sell li strong { display: block; }
            .sell li span { color: #c9d5e6; font-size: 14px; }

            /* Contact */
            .contact { text-align: center; max-width: 640px; margin: 0 auto; }
            .contact .btn { font-size: 17px; padding: 16px 30px; }
            .contact-number { margin-top: 18px; font-size: 18px; font-weight: 700; color: var(--navy); }
            .contact small { display: block; color: var(--muted); margin-top: 6px; }

            /* Footer */
            .footer { background: var(--navy); color: #c9d5e6; padding: 36px 0; font-size: 14px; }
            .footer .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; }
            .footer a:hover { color: #fff; }

            /* Floating WhatsApp */
            .wa-float {
                position: fixed; right: 18px; bottom: 18px; z-index: 60; width: 56px; height: 56px; border-radius: 50%;
                background: var(--green); color: #fff; display: grid; place-items: center; box-shadow: 0 10px 24px rgba(0,0,0,.25);
            }
            .wa-float svg { width: 28px; height: 28px; }

            /* Responsive */
            @media (max-width: 1080px) {
                .cat-grid, .prod-grid { grid-template-columns: repeat(2, 1fr); }
            }
            @media (max-width: 860px) {
                .nav { flex-wrap: wrap; }
                .nav-links { order: 3; width: 100%; overflow-x: auto; gap: 20px; padding-top: 6px; font-size: 14px; }
                .steps, .sell { grid-template-columns: 1fr; }
                .sell { padding: 36px 24px; }
                .section { padding: 64px 0; }
                .hero { padding: 72px 0 80px; }
            }
            @media (max-width: 560px) {
                .cat-grid, .prod-grid { grid-template-columns: 1fr; }
                .cat-card { min-height: 260px; }
                .hero-actions .btn { width: 100%; }
            }
        </style>
    </head>

    <body>
        <header class="header">
            <div class="container nav">
                <a href="#home" class="logo">Amic<span>Bridge</span></a>
                <nav class="nav-links">
                    <a href="#home">Home</a>
                    <a href="#categories">Categories</a>
                    <a href="#products">Products</a>
                    <a href="#sell">Sell With Us</a>
                    <a href="#contact">Contact</a>
                </nav>
                <a href={sellLink} target="_blank" rel="noopener" class="btn btn-wa">List Your Product</a>
            </div>
        </header>

        <main>
            <section class="hero" id="home">
                <div class="container">
                    <span class="eyebrow">Global B2B Trading Marketplace</span>
                    <h1>Connecting buyers and sellers worldwide</h1>
                    <p>
                        Diamonds, cars, commodities and more. Contact AmicBridge on WhatsApp. We introduce you to trusted
                        sellers, and you negotiate the deal directly with them.
                    </p>
                    <div class="hero-actions">
                        <a href="#products" class="btn btn-light">Browse Products</a>
                        <a href={buyLink} target="_blank" rel="noopener" class="btn btn-wa"><Fragment set:html={waIcon} /> Chat on WhatsApp</a>
                        <a href={sellLink} target="_blank" rel="noopener" class="btn btn-outline">List Your Product</a>
                    </div>
                    <ul class="hero-points">
                        <li>International buyers & sellers</li>
                        <li>Direct price negotiation</li>
                        <li>Personal introductions</li>
                    </ul>
                </div>
            </section>

            <section class="section" id="categories">
                <div class="container">
                    <div class="section-head">
                        <span class="eyebrow">Categories</span>
                        <h2>What we trade</h2>
                        <p>From precious stones to vehicles and bulk goods, we source and connect across borders.</p>
                    </div>
                    <div class="cat-grid">
                        {
                            categories.map((c) => (
                                <a class="cat-card" href={whatsappLink(`Hello AmicBridge, I am interested in ${c.name}.`)} target="_blank" rel="noopener">
                                    <img src={c.image} alt={c.name} loading="lazy" />
                                    <div>
                                        <h3>{c.name}</h3>
                                        <p>{c.description}</p>
                                        <ul>
                                            {c.items.map((i) => (
                                                <li>{i}</li>
                                            ))}
                                        </ul>
                                    </div>
                                </a>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="section section-alt" id="products">
                <div class="container">
                    <div class="section-head">
                        <span class="eyebrow">Products</span>
                        <h2>Current listings</h2>
                        <p>Prices aren't listed. They're negotiated directly between buyer and seller. Enquire to get full details.</p>
                    </div>
                    <div class="prod-grid">
                        {
                            products.map((p) => (
                                <article class="prod-card">
                                    <div class="prod-img">
                                        <img src={p.image} alt={p.alt} loading="lazy" />
                                        <span class="prod-tag">{p.tag}</span>
                                    </div>
                                    <div class="prod-body">
                                        <span class="prod-cat">{categoryName(p.category)}</span>
                                        <h3>
                                            {p.name} – {p.tag}
                                        </h3>
                                        <p>{p.summary}</p>
                                        <ul class="prod-details">
                                            {p.details.map((d) => (
                                                <li>{d}</li>
                                            ))}
                                        </ul>
                                        <div class="prod-price">Price: negotiable with seller</div>
                                        <a
                                            href={whatsappLink(`Hello AmicBridge, I am interested in: ${p.name} – ${p.tag}. Please share more details.`)}
                                            target="_blank"
                                            rel="noopener"
                                            class="btn btn-wa btn-block"
                                        >
                                            <Fragment set:html={waIcon} /> Enquire on WhatsApp
                                        </a>
                                    </div>
                                </article>
                            ))
                        }
                    </div>
                    <p class="more-note">
                        Looking for something not listed? <a href={buyLink} target="_blank" rel="noopener">Tell us what you need →</a>
                    </p>
                </div>
            </section>

            <section class="section" id="how">
                <div class="container">
                    <div class="section-head">
                        <span class="eyebrow">How it works</span>
                        <h2>Simple, personal, direct</h2>
                        <p>Every buyer contacts AmicBridge first. We handle the introduction so both sides can focus on the deal.</p>
                    </div>
                    <div class="steps">
                        {
                            steps.map((s, i) => (
                                <div class="step">
                                    <div class="step-num">{i + 1}</div>
                                    <h3>{s.title}</h3>
                                    <p>{s.text}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="section section-alt" id="sell">
                <div class="container">
                    <div class="sell">
                        <div>
                            <span class="eyebrow">Sell With Us</span>
                            <h2>Reach international buyers</h2>
                            <p>
                                List diamonds, vehicles, commodities or any other product. Send us the details and photos on
                                WhatsApp and we present your listing to serious buyers worldwide. AmicBridge earns a commission
                                only when an introduction leads to a successful deal.
                            </p>
                            <a href={sellLink} target="_blank" rel="noopener" class="btn btn-wa"><Fragment set:html={waIcon} /> List Your Product</a>
                        </div>
                        <ul>
                            <li><strong>No listing fees</strong><span>Commission only on successful deals.</span></li>
                            <li><strong>Global reach</strong><span>Buyers from Europe, Africa, the Middle East, Asia and beyond.</span></li>
                            <li><strong>You set the price</strong><span>Negotiate terms directly with the buyer.</span></li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="section" id="contact">
                <div class="container contact">
                    <div class="section-head">
                        <span class="eyebrow">Contact</span>
                        <h2>Talk to AmicBridge</h2>
                        <p>Buying or selling? Message us on WhatsApp and we will connect you with the right partner.</p>
                    </div>
                    <a href={buyLink} target="_blank" rel="noopener" class="btn btn-wa"><Fragment set:html={waIcon} /> Message us on WhatsApp</a>
                    <div class="contact-number">{WHATSAPP_DISPLAY}</div>
                    <small>Available for buyers and sellers worldwide</small>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="container">
                <div>© {new Date().getFullYear()} AmicBridge. Global B2B trading marketplace.</div>
                <div><a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp: {WHATSAPP_DISPLAY}</a></div>
            </div>
        </footer>

        <a href={buyLink} target="_blank" rel="noopener" class="wa-float" aria-label="Chat with AmicBridge on WhatsApp"><Fragment set:html={waIcon} /></a>
    </body>
</html>
