---
const { value = 70 } = Astro.props;
---

<div class="progress-container">
  <div
    class="progress-bar"
    style={`width:${value}%`}
  ></div>
</div>

<style>

  .progress-container {
    width: 100%;
    height: 12px;
    background: rgba(255,255,255,0.08);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 14px;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(
      90deg,
      #d6a85f,
      #f0c67a
    );
    border-radius: 999px;
    transition: width 0.4s ease;
  }

</style>
