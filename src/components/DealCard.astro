---
import ProgressBar from "./ProgressBar.astro";

const {
  title,
  price,
  region,
  image
} = Astro.props;
---

<div class="card">

  <img src={image} alt={title} />

  <div class="content">

    <h2>{title}</h2>

    <p>{region}</p>

    <div class="price">
      {price}
    </div>

    <ProgressBar value={80} />

    <button>
      Request Deal
    </button>

  </div>

</div>

<style>

  .card{
    background:#111;
    border-radius:24px;
    overflow:hidden;
    color:white;
  }

  img{
    width:100%;
    height:240px;
    object-fit:cover;
  }

  .content{
    padding:24px;
  }

  h2{
    font-size:32px;
    margin-bottom:10px;
  }

  p{
    color:#aaa;
    margin-bottom:20px;
  }

  .price{
    font-size:42px;
    font-weight:900;
    margin-bottom:20px;
    color:#d6a85f;
  }

  button{
    width:100%;
    border:none;
    padding:16px;
    border-radius:999px;
    background:#d6a85f;
    color:black;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    margin-top:20px;
  }

</style>
