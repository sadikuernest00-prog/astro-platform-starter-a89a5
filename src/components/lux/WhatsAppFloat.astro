---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink, defaultWhatsappMessage } from '../../data/site';
---
<a href={whatsappLink(defaultWhatsappMessage)} target="_blank" rel="noopener noreferrer" class="wa-float" aria-label="Chat with us on WhatsApp">
