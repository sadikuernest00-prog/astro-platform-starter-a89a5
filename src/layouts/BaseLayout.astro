---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AmicBridge",
  description = "Community funding pools for real opportunities.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --bg: #07111f;
        --bg-soft: #0d1728;
        --card: rgba(255, 255, 255, 0.06);
        --card-border: rgba(255, 255, 255, 0.12);
        --text: #f6f8fb;
        --muted: #a8b3c7;
        --primary: #4f8cff;
        --primary-2: #6aa5ff;
        --success: #3ddc97;
        --warning: #f5b942;
        --danger: #ff6b6b;
        --max: 1180px;
        --radius: 20px;
        --shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(79, 140, 255, 0.15), transparent 30%),
          linear-gradient(180deg, #07111f 0%, #091425 100%);
        color: var(--text);
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(var(--max), calc(100% - 32px));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(7, 17, 31, 0.7);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 0;
      }

      .brand {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .brand-logo {
        font-size: 1.7rem;
        font-weight: 900;
        letter-spacing: 0.04em;
      }

      .brand-logo span {
        color: var(--primary-2);
      }

      .brand-sub {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: var(--muted);
        font-weight: 600;
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .btn,
      button,
      input[type="submit"] {
        border: 0;
        border-radius: 999px;
        padding: 14px 20px;
        font-weight: 800;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-2));
        color: white;
        box-shadow: 0 16px 40px rgba(79, 140, 255, 0.25);
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        filter: brightness(1.04);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        color: var(--text);
        border: 1px solid var(--card-border);
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      .section {
        padding: 84px 0;
      }

      .hero {
        display: grid;
        grid-template-columns: 1.2fr 0.9fr;
        gap: 28px;
        align-items: center;
        padding: 76px 0 52px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.86rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #bcd3ff;
        background: rgba(79, 140, 255, 0.12);
        border: 1px solid rgba(79, 140, 255, 0.24);
        border-radius: 999px;
        padding: 10px 14px;
      }

      h1,
      h2,
      h3 {
        margin: 0 0 12px;
        line-height: 1.05;
      }

      h1 {
        font-size: clamp(2.5rem, 5vw, 4.8rem);
      }

      h2 {
        font-size: clamp(1.8rem, 3vw, 3rem);
      }

      h3 {
        font-size: 1.25rem;
      }

      .lead {
        color: var(--muted);
        font-size: 1.12rem;
        max-width: 760px;
        line-height: 1.65;
      }

      .hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .card,
      .stat-card,
      .deal-card {
        background: var(--card);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
      }

      .card {
        padding: 24px;
      }

      .stat-card {
        padding: 22px;
      }

      .stat-label {
        color: var(--muted);
        font-weight: 700;
        margin-bottom: 8px;
      }

      .stat-value {
        font-size: 2rem;
        font-weight: 900;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
      }

      .section-copy {
        color: var(--muted);
        max-width: 700px;
      }

      .deal-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .deal-card {
        padding: 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .deal-top {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 12px;
      }

      .deal-status {
        font-size: 0.82rem;
        font-weight: 800;
        border-radius: 999px;
        padding: 8px 10px;
        text-transform: capitalize;
      }

      .status-open {
        background: rgba(79, 140, 255, 0.14);
        color: #b7d1ff;
      }

      .status-funded {
        background: rgba(61, 220, 151, 0.14);
        color: #9df2ca;
      }

      .status-active {
        background: rgba(245, 185, 66, 0.14);
        color: #ffd980;
      }

      .deal-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .deal-meta strong {
        display: block;
        font-size: 0.88rem;
        color: var(--muted);
        margin-bottom: 4px;
      }

      .progress-wrap {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .progress-bar {
        height: 12px;
        width: 100%;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        overflow: hidden;
      }

      .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary), var(--success));
        width: 0%;
        transition: width 0.25s ease;
      }

      .progress-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .deal-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: auto;
      }

      .muted {
        color: var(--muted);
      }

      .pill-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .pill {
        border-radius: 999px;
        padding: 10px 12px;
        border: 1px solid rgba(61, 220, 151, 0.22);
        background: rgba(61, 220, 151, 0.08);
        color: #b9f3da;
        font-size: 0.92rem;
        font-weight: 700;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }

      .step-card {
        padding: 24px;
        background: var(--card);
        border: 1px solid var(--card-border);
        border-radius: var(--radius);
      }

      .step-num {
        display: inline-flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(79, 140, 255, 0.14);
        color: #c5daff;
        font-weight: 900;
        margin-bottom: 14px;
      }

      .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
      }

      .form-shell {
        max-width: 820px;
      }

      form {
        display: grid;
        gap: 16px;
      }

      .field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      label {
        display: grid;
        gap: 8px;
        font-weight: 700;
      }

      input,
      textarea,
      select {
        width: 100%;
        border-radius: 16px;
        border: 1px solid var(--card-border);
        background: rgba(255, 255, 255, 0.04);
        color: var(--text);
        padding: 14px 16px;
        outline: none;
        font: inherit;
      }

      textarea {
        min-height: 140px;
        resize: vertical;
      }

      input::placeholder,
      textarea::placeholder {
        color: #8f9db6;
      }

      .notice {
        border-radius: 16px;
        padding: 14px 16px;
        border: 1px solid rgba(61, 220, 151, 0.18);
        background: rgba(61, 220, 151, 0.08);
        color: #c5f7e1;
      }

      .site-footer {
        padding: 32px 0 56px;
        color: var(--muted);
      }

      @media (max-width: 980px) {
        .hero,
        .two-col,
        .deal-grid,
        .card-grid,
        .steps,
        .field-grid {
          grid-template-columns: 1fr;
        }

        .nav {
          align-items: flex-start;
          flex-direction: column;
        }

        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">
          <div class="brand-logo">AMIC<span>BRIDGE</span></div>
          <div class="brand-sub">Trust-first funding pools for real opportunities</div>
        </a>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/deals">Deals</a>
          <a href="/create-deal">Create deal</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} AmicBridge — Pool money. Fund opportunities. Earn together.
      </div>
    </footer>
  </body>
</html>
